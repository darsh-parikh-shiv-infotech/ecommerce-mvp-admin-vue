#!/usr/bin/env sh

# ---- pretty output -------------------------------------------------------
BOLD=$(printf '\033[1m');  DIM=$(printf '\033[2m');   RESET=$(printf '\033[0m')
BLUE=$(printf '\033[34m'); GREEN=$(printf '\033[32m'); RED=$(printf '\033[31m')

started=$(date +%s)

step() { printf '\n%s\n' "${BLUE}${BOLD}==>${RESET} ${BOLD}$1${RESET}"; }
ok()   { printf '%s\n'   "    ${GREEN}v${RESET} ${DIM}$1${RESET}"; }
die()  {
  printf '\n%s\n'   "${RED}${BOLD}x  $1${RESET}"
  printf '%s\n\n'   "${DIM}   commit aborted - fix the above, then commit again${RESET}"
  exit 1
}

printf '\n%s\n' "${BOLD}Relecca pre-commit${RESET} ${DIM}lint - types - build${RESET}"

# ---- 1. staged files only (fast) ----------------------------------------
step "Linting and formatting staged files"
npx lint-staged || die "Lint/format failed"
ok "staged files clean"

# ---- 2. whole project: a type error usually starts in another file -------
step "Type-checking project"
npm run type-check || die "Type check failed"
ok "no type errors"

# ---- 3. build to a throwaway dir so the committed dist/ is left alone ----
step "Verifying production build"
npm run build || die "Build failed"
ok "build succeeded"

printf '\n%s\n\n' "${GREEN}${BOLD}All checks passed${RESET} ${DIM}($(( $(date +%s) - started ))s)${RESET}"